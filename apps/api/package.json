    "@mizvo/shared-types": "workspace:*",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "vitest": "^3.2.4"
  }
