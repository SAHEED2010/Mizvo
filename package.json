{
  "name": "mizvo",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @mizvo/shared-types build && pnpm --filter @mizvo/shared-schemas build && pnpm --parallel --filter @mizvo/web --filter @mizvo/api dev",
    "build": "pnpm --recursive --if-present build",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present build && pnpm --recursive --if-present test",
    "test:postgres": "pnpm --filter @mizvo/database build && pnpm --filter @mizvo/api test:postgres",
    "lint": "biome check .",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "drizzle-kit": "0.31.11",
    "typescript": "^5.9.3"
  }
}
