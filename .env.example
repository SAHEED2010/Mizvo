# Optional local API settings; these are the server defaults.
HOST=127.0.0.1
PORT=4000

# Authentication stays disabled until a compliant phone OTP provider, delivery
# path, rate limits, trusted origins, and abuse protections have been reviewed.
AUTH_ENABLED=false
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:4000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
TRUSTED_PROXY_CIDRS=

# Server-only OTP delivery. Keep disabled until a provider is approved and has
# passed restricted integration testing before any public registration.
OTP_DELIVERY_PROVIDER=disabled

# Optional Africa's Talking adapter configuration. Leave blank until its
# eligibility, Nigerian sender ID, credentials and delivery are verified.
AT_ENVIRONMENT=production
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Private Next.js rewrite target. Browser auth requests stay same-origin.
MIZVO_API_ORIGIN=http://127.0.0.1:4000
